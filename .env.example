# ─── App Configuration ────────────────────────────────────────────────────────
# Public base URL — used for sitemap.xml, robots.txt, OG tags, and canonical URLs (no trailing slash)
NEXT_PUBLIC_BASE_URL=https://tecunique.com

# ─── Email Service (Resend) ───────────────────────────────────────────────────
# Company Resend API Key: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Verified domain sender (e.g., noreply@tecunique.com after verifying tecunique.com in Resend)
EMAIL_FROM_ADDRESS=TecUnique Contact <noreply@tecunique.com>

# Inboxes that receive contact inquiries (comma-separated for multiple)
CONTACT_RECEIVER_EMAILS=sales@tecunique.com,info@tecunique.com

# Inbox that receives career applications
HR_EMAIL_ADDRESS=hr@tecunique.com

# ─── Database (MongoDB Atlas) ─────────────────────────────────────────────────
# Company MongoDB Atlas production connection string
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/tecunique?appName=tecunique
MONGODB_USERNAME=tecunique_prod_user
MONGODB_PASSWORD=your_strong_db_password

# ─── Admin Security & Authentication ──────────────────────────────────────────
# Cryptographic secret for signing Admin JWT tokens (generate a 64-char random hex string)
ADMIN_JWT_SECRET=generate_strong_random_secret_here

# Initial/fallback admin credentials
ADMIN_USERNAME=admintecunique
ADMIN_PASSWORD=change_me_to_strong_password

# ─── Admin Access Restriction & Whitelisting ──────────────────────────────────
# IP Whitelisting: Restrict access to /admin and /api/admin to only this IP (or comma-separated IPs)
# Example: ALLOWED_ADMIN_IP=203.0.113.195
# Leave blank or commented out in local development
ALLOWED_ADMIN_IP=

# Subdomain Separation: If admin panel is hosted on a separate subdomain (e.g. admin.tecunique.com),
# set this to enforce that /admin is only reachable on that domain and returns 404 on the main website.
ADMIN_HOST=
